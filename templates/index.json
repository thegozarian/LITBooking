    "custom_liquid_A9a6yF": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .lit-pg { --lit-red: #C8102E; --lit-ink: #1A1A1A; --lit-card: #FFFFFF; --lit-muted: #5A5A5A; color: var(--lit-ink); max-width: 960px; margin: 0 auto; padding: 0 16px; font-size: 17px; line-height: 1.6; letter-spacing: normal; }\n  .lit-pg h2 { font-size: 32px; line-height: 1.2; font-weight: 700; letter-spacing: -0.01em; margin: 56px 0 16px; padding-left: 14px; border-left: 6px solid var(--lit-red); }\n  .lit-pg h3 { font-size: 21px; line-height: 1.3; font-weight: 700; letter-spacing: normal; margin: 0 0 8px; }\n  .lit-pg p { font-size: 17px; line-height: 1.6; letter-spacing: normal; margin: 0 0 16px; }\n  .lit-pg .lit-lead { font-size: 19px; line-height: 1.55; }\n  .lit-pg .lit-grid { display: grid; gap: 16px; margin: 16px 0 24px; }\n  .lit-pg .lit-grid-2 { grid-template-columns: repeat(2, 1fr); }\n  .lit-pg .lit-grid-3 { grid-template-columns: repeat(3, 1fr); }\n  @media (max-width: 900px) { .lit-pg .lit-grid-3 { grid-template-columns: 1fr; } }\n  @media (max-width: 600px) { .lit-pg .lit-grid-2 { grid-template-columns: 1fr; } .lit-pg h2 { font-size: 26px; } }\n  .lit-pg .lit-card { background: var(--lit-card); border-top: 4px solid var(--lit-ink); padding: 20px 22px; display: flex; flex-direction: column; }\n  .lit-pg .lit-card p { font-size: 16px; margin: 0 0 16px; }\n  .lit-pg .lit-feature { border-top-color: var(--lit-red); }\n  .lit-pg .lit-more { margin-top: auto; font-size: 16px; font-weight: 700; color: var(--lit-red); text-decoration: none; }\n  .lit-pg .lit-more:hover { text-decoration: underline; }\n  .lit-pg .lit-cta { background: var(--lit-ink); color: #FFFFFF; padding: 32px 28px; margin: 56px 0 16px; }\n  .lit-pg .lit-cta h2 { color: #FFFFFF; margin-top: 0; }\n  .lit-pg .lit-cta p { color: #FFFFFF; }\n  .lit-pg .lit-btn { display: inline-block; background: var(--lit-red); color: #FFFFFF; text-decoration: none; font-size: 17px; font-weight: 700; padding: 12px 24px; margin: 8px 12px 0 0; }\n  .lit-pg .lit-btn:hover { background: #A00D25; color: #FFFFFF; }\n  .lit-pg .lit-btn-ghost { background: transparent; border: 2px solid #FFFFFF; padding: 10px 22px; }\n  .lit-pg .lit-btn-ghost:hover { background: #FFFFFF; color: var(--lit-ink); }\n</style>\n\n<div class=\"lit-pg\">\n  <h2>Technology that works the way your business does</h2>\n  <p class=\"lit-lead\">We're an Irish engineering and technology company that takes the repetitive, time-consuming work out of running a business. We connect your systems, automate your processes and build the tools your team actually needs, so you spend less time on admin and more time on the work that matters.</p>\n\n  <div class=\"lit-grid lit-grid-2\">\n    <div class=\"lit-card\">\n      <h3>Integrations</h3>\n      <p>Your store, accounts, spreadsheets, machines and sensors each hold part of the picture. We bring them together into one live dashboard or management app, so you can see and run everything from one place.</p>\n      <a class=\"lit-more\" href=\"/pages/integrations\">Explore integrations →</a>\n    </div>\n    <div class=\"lit-card\">\n      <h3>Workflows</h3>\n      <p>Orders, quotes, invoices, reminders and reports that follow the same steps every time can run themselves. You get hours back every week, fewer errors and faster service for your customers.</p>\n      <a class=\"lit-more\" href=\"/pages/workflows\">Explore workflows →</a>\n    </div>\n    <div class=\"lit-card\">\n      <h3>Compliance automation</h3>\n      <p>Built to the current edition of your standard and your own procedures, our systems guide your team through each step and keep the records your auditor wants to see, ready every day.</p>\n      <a class=\"lit-more\" href=\"/pages/compliance\">Explore compliance automation →</a>\n    </div>\n    <div class=\"lit-card\">\n      <h3>Design &amp; IP</h3>\n      <p>From concept to tested, manufacturable design, with the engineering work that helps protect your intellectual property. We work alongside our legal partners, so your idea is secured before anyone else sees it.</p>\n      <a class=\"lit-more\" href=\"/pages/design-ip\">Explore design &amp; IP →</a>\n    </div>\n  </div>\n\n  <h2>Why clients choose us</h2>\n  <div class=\"lit-grid lit-grid-3\">\n    <div class=\"lit-card lit-feature\">\n      <h3>A personal service</h3>\n      <p>You deal directly with the engineer designing and building your solution, from the first conversation to long after launch. No call centres and no handovers.</p>\n    </div>\n    <div class=\"lit-card lit-feature\">\n      <h3>Ready on day one</h3>\n      <p>Every project is fully tested against what we agreed before it goes live, so you get a polished, customer-ready system rather than a work in progress. If anything doesn't work as agreed, we fix it free for 30 days.</p>\n    </div>\n    <div class=\"lit-card lit-feature\">\n      <h3>Training included</h3>\n      <p>We come onsite to train your team as part of every project, so everyone is confident using the new system from the start.</p>\n    </div>\n  </div>\n  <p>We don't consider a project finished until it's working for you. That commitment is behind every solution we deliver.</p>\n\n  <div class=\"lit-cta\">\n    <h2>Let's get your time back</h2>\n    <p>Tell us what's slowing your business down, or book a chat with an engineer to talk it through.</p>\n    <a class=\"lit-btn\" href=\"/pages/make-booking\">Book an engineer</a>\n    <a class=\"lit-btn lit-btn-ghost\" href=\"/pages/contact\">Contact us</a>\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
